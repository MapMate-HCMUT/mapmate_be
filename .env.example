PORT=3000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mapmate?retryWrites=true&w=majority
# DB_NAME=mapmate
# Chỉ script tạo collection (node --env-file=.env src/scripts/initCollections.js) đọc biến này — đặt giống MONGO_URI
# MONGODB_URI=

# Chuỗi bí mật ký JWT — tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Domain frontend được phép gọi API (nhiều domain cách nhau bởi dấu phẩy)
CORS_ORIGIN=http://localhost:5173

# Groq — AI Planner (/ai-planner). Lấy key ở https://console.groq.com/keys (để trống => chạy bản dự phòng theo luật)
GROQ_API_KEY=
# Tuỳ chọn: đổi model (mặc định openai/gpt-oss-20b / openai/gpt-oss-120b)
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_SMART=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Chạy sau reverse proxy (Nginx, Render, Railway...) => số tầng proxy, để rate limit đếm đúng IP người dùng. Chạy trực tiếp: bỏ trống
# TRUST_PROXY=1

# Cloudinary — lưu ảnh / video người dùng đăng kèm bài viết & đánh giá địa điểm (gói miễn phí ~25GB).
# Lấy ở https://console.cloudinary.com → Dashboard (Product Environment): Cloud name, API Key, API Secret.
# Để trống => vẫn đăng bài được nhưng không đính kèm ảnh / video.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
